# Copy to .env (gitignored) and adjust. Never put a real key in this file.
# Load it with:  set -a; source .env; set +a

# --- Speech-to-text provider -------------------------------------------------
# mock (default, offline, free) | gnani (real, spends credits) | disabled
STT_PROVIDER=mock
# Second switch. Gnani is only called when STT_PROVIDER=gnani AND this is true AND a key is set.
GNANI_LIVE_CALLS_ENABLED=false
# From app.gnani.ai/voice. Leave empty until you are ready for live calls.
GNANI_API_KEY=
GNANI_MODEL=prisma-v3.0
# transliterate = Latin script for every language (WhatsApp style). Others: verbatim | transcribe | codemix
GNANI_FORMAT=transliterate
# Default hint when the upload sends none: indic-auto or one of bn-IN en-IN gu-IN hi-IN kn-IN ml-IN mr-IN pa-IN ta-IN te-IN
GNANI_LANGUAGE=indic-auto
GNANI_TIMEOUT_SECONDS=20
GNANI_MAX_RETRIES=1

# --- Credit budget (whole server, lifetime) ----------------------------------
# Keep BELOW your remaining credits. Gnani does not document the credit unit, so both are capped.
BUDGET_TOTAL_REQUESTS=300
BUDGET_TOTAL_AUDIO_SECONDS=3600
GLOBAL_DAILY_REQUESTS=100
MAX_QUEUE_DEPTH=20

# --- Per-user limits ----------------------------------------------------------
USER_REQUESTS_PER_MINUTE=3
USER_DAILY_REQUESTS=20
USER_DAILY_AUDIO_SECONDS=300
USER_MAX_PENDING_JOBS=2

# --- Upload validation ---------------------------------------------------------
MAX_UPLOAD_BYTES=2000000
# Hard-capped at 30 (Gnani REST maximum) whatever you set.
MAX_AUDIO_SECONDS=30
MIN_AUDIO_SECONDS=0.5

# --- Auth ------------------------------------------------------------------------
# Set before exposing the server publicly, so strangers cannot register and use quota.
REGISTRATION_CODE=
SESSION_HOURS=72
LOGIN_ATTEMPTS_PER_15_MIN=10

# --- Runtime ---------------------------------------------------------------------
# DATABASE_PATH=data/promise_keeper.db
APP_TIMEZONE=Asia/Kolkata
WORKER_ENABLED=true
# Built web app (cd ../web && npm run build). Default: ../web/dist. If it is missing, / serves static/index.html.
# WEB_DIST_PATH=../web/dist

# --- Optional LLM second opinion (Gnani Evon v3.3, self-hosted) -------------------
# none (default) | mock (offline; repeats the rules, for demos) | openai_compat (your own server)
# Asked only for languages with starter rules, or when a promise has no time we could parse.
LLM_PROVIDER=none
# Your own OpenAI-compatible server, e.g. vLLM or llama.cpp: http://127.0.0.1:8001/v1
EVON_BASE_URL=
# Only if your server needs a key. Never commit it.
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
LLM_TIMEOUT_SECONDS=15
LLM_DAILY_REQUESTS=200
LLM_MAX_TOKENS=200
LLM_MIN_CONFIDENCE=0.6

# --- Web Push (notifications when a reminder is due) -------------------------------
# Generate once with:  .venv/bin/python -m app.admin vapid   and paste the two values here (in .env, never in Git).
# Both empty = notifications are off. Changing the keys later invalidates every existing subscription.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact the push services can use: mailto:you@example.com or an https URL you own.
VAPID_SUBJECT=

# --- Demo seed (local only) ------------------------------------------------------
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-123
